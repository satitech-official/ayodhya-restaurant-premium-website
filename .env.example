# PostgreSQL connection used by the admin panel, reservations, contact messages and live content editing.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Change these before seeding a production database.
ADMIN_EMAIL=admin@ayodhyarestaurant.in
ADMIN_PASSWORD=change-this-strong-password

# Use a long random value in production.
AUTH_SECRET=replace-with-a-long-random-secret
